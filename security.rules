rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ইউজাররা শুধুমাত্র তাদের নিজেদের প্রোফাইল দেখতে ও এডিট করতে পারবে
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // যে কেউ কাজের লিস্ট দেখতে পারবে, কিন্তু জব পোস্ট করতে হলে লগইন থাকতে হবে
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.buyerId == request.auth.uid;
    }

    // প্রুফ বা কাজের প্রমাণ শুধুমাত্র লগইন করা ইউজার জমা দিতে পারবে
    match /proofs/{proofId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid);
    }

    // ডিপোজিট এবং উইথড্র রিকোয়েস্ট শুধুমাত্র নিজেরটা নিজে দেখতে পারবে
    match /deposits/{depId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /withdraws/{withId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // এডমিনের জন্য স্পেশাল রুলস (ম্যানুয়ালি ফায়ারবেস কনসোল থেকে সেট করা ভালো)
    // আপাতত ডেভেলপমেন্টের জন্য সব রিকোয়েস্ট কিছু শর্তে ওপেন রাখা হলো
  }
}

